# =====================================================================
#  deus-daf — VirtualHost Apache 2.4
# =====================================================================
#  À copier dans /etc/apache2/sites-available/daf.exemple.fr.conf puis :
#      a2enmod rewrite headers expires ssl
#      a2ensite daf.exemple.fr
#      apachectl configtest && systemctl reload apache2
#
#  Remplacer partout :
#      daf.exemple.fr    → votre nom de domaine
#      /var/www/deus-daf → le chemin d'installation
#
#  « AllowOverride All » est INDISPENSABLE : c'est le .htaccess livré à
#  la racine du projet qui bloque l'accès aux includes, au schéma SQL et
#  aux journaux. Sans lui, ces fichiers seraient servis en clair.
# =====================================================================

# ---------------------------------------------------------------------
# HTTP : redirection vers HTTPS
# ---------------------------------------------------------------------
<VirtualHost *:80>
    ServerName daf.exemple.fr
    DocumentRoot /var/www/deus-daf

    # Laisser passer la validation Let's Encrypt.
    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
        RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>
</VirtualHost>

# ---------------------------------------------------------------------
# HTTPS : le vhost applicatif
# ---------------------------------------------------------------------
<VirtualHost *:443>
    ServerName    daf.exemple.fr
    DocumentRoot  /var/www/deus-daf
    ServerAdmin   admin@exemple.fr

    ErrorLog  ${APACHE_LOG_DIR}/deus-daf-error.log
    CustomLog ${APACHE_LOG_DIR}/deus-daf-access.log combined

    # -----------------------------------------------------------------
    # TLS — chemins produits par certbot
    # -----------------------------------------------------------------
    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/daf.exemple.fr/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/daf.exemple.fr/privkey.pem

    SSLProtocol            -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder    off
    SSLSessionTickets      off
    SSLUseStapling         on

    # -----------------------------------------------------------------
    # Répertoire applicatif
    # -----------------------------------------------------------------
    <Directory /var/www/deus-daf>
        # Sans cette ligne, le .htaccess est ignoré et l'application
        # n'est plus protégée.
        AllowOverride All

        Options -Indexes -ExecCGI -Includes +FollowSymLinks
        Require all granted

        DirectoryIndex index.php
    </Directory>

    # -----------------------------------------------------------------
    # PHP-FPM
    # -----------------------------------------------------------------
    # Adapter la version de la socket à celle installée sur le serveur.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.2-fpm.sock|fcgi://localhost/"
    </FilesMatch>

    # Ne pas annoncer la version de PHP.
    <IfModule mod_headers.c>
        Header always unset X-Powered-By
    </IfModule>

    # Aucun téléversement dans cette application.
    LimitRequestBody 1048576
</VirtualHost>
